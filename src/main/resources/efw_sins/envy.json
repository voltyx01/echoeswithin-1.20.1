    {"id": "e_borrow", "name": "Чужие таблетки", "text": "Стимуляторы действуют дольше. Лекарства — хуже.",
      "buff": [{"stat": "effect.stim", "value": 0.20}],
      "cost": [{"stat": "effect.antibiotic", "value": -0.15}]},
    {"id": "e_not_behind", "name": "Не отстать", "text": "Сердце бьётся, чтобы успеть.",
      "buff": [{"stat": "stamina.max", "value": 0.10}],
      "cost": [{"stat": "pulse.rest", "value": 6}]}
  ]
