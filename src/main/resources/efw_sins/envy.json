          {"stat": "melee.damage", "value": 0.10, "when": ["target_hp<0.5"]},
          {"stat": "gun.damage", "value": 0.10, "when": ["target_hp<0.5"]}
        ]},
      {"name": "Равняюсь на сильных", "text": "Сильным — в голову.",
