      {"stat": "melee.damage", "value": 0.10, "when": ["target_stronger"]},
      {"stat": "gun.damage", "value": 0.10, "when": ["target_stronger"]},
      {"stat": "melee.damage", "value": -0.05, "when": ["!target_stronger"]},
      {"stat": "gun.damage", "value": -0.05, "when": ["!target_stronger"]}
    ]
  },
  "branches": [
